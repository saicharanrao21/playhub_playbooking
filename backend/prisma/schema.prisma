// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DISABLED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum KYCStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum BusinessStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum VenueStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  CHECKED_IN
  NO_SHOW
  COMPLETED
}

enum PaymentStatus {
  INITIATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  MOCK
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BlockReason {
  MAINTENANCE
  HOLIDAY
  BUSINESS_CLOSE
  OTHER
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SYSTEM_ALERT
}

enum MediaType {
  IMAGE
  DOCUMENT
}

enum CommunicationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum CommunicationCategory {
  TRANSACTIONAL
  MARKETING
  SECURITY
}

enum CommunicationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum FinancialTransactionType {
  PAYMENT
  REFUND
  PAYOUT
  COMMISSION
  ADJUSTMENT
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  phoneNumber     String?       @unique
  fullName        String?
  passwordHash    String?
  avatarUrl       String?
  status          AccountStatus @default(ACTIVE)
  isEmailVerified Boolean       @default(false)
  isPhoneVerified Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships              Membership[]
  sessions                 Session[]
  auditLogs                AuditLog[]
  bookings                 Booking[]
  notifications            Notification[]
  media                    Media[]
  devices                  Device[]
  communicationPreferences CommunicationPreference[]
  communicationLogs        CommunicationLog[]
  staffCheckIns            CheckIn[]               @relation("StaffCheckIns")
  userCheckIns             CheckIn[]
  createdFinancialTransactions FinancialTransaction[] @relation("CreatedTransactions")
  customerMemberships      CustomerMembership[]
  couponRedemptions        CouponRedemption[]
  referralCode             ReferralCode?
  sentReferrals            Referral[]              @relation("Referrer")
  receivedReferral         Referral?               @relation("Referee")
  loyaltyAccount           LoyaltyAccount?
  loyaltyTransactions      LoyaltyTransaction[]

  @@map("users")
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  kycStatus         KYCStatus @default(DRAFT)
  panNumber         String?
  gstNumber         String?
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  bankName          String?

  memberships   Membership[]
  businesses    Business[]
  bookings      Booking[]
  payments      Payment[]
  notifications Notification[]
  media         Media[]
  checkIns      CheckIn[]
  financialTransactions FinancialTransaction[]
  ledgerEntries         LedgerEntry[]
  settlements           Settlement[]
  payouts               Payout[]
  commissionConfigs     CommissionConfig[]
  auditLogs             AuditLog[]
  membershipPlans       MembershipPlan[]
  customerMemberships   CustomerMembership[]
  coupons               Coupon[]

  @@map("organizations")
}

model City {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  state     String?
  country   String   @default("India")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues Venue[]

  @@map("cities")
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  roles        Role[]       @relation("MembershipRoles")

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[] @relation("RolePermissions")
  memberships Membership[] @relation("MembershipRoles")

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String // e.g., 'read', 'create'
  resource    String // e.g., 'venue', 'booking'
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[] @relation("RolePermissions")

  @@unique([action, resource])
  @@map("permissions")
}

model Business {
  id             String         @id @default(uuid())
  organizationId String
  legalName      String
  displayName    String
  status         BusinessStatus @default(PENDING_ONBOARDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  venues       Venue[]

  @@index([organizationId])
  @@map("businesses")
}

model Venue {
  id          String      @id @default(uuid())
  businessId  String
  cityId      String?
  name        String
  slug        String
  description String?
  address     String
  city        String
  state       String
  country     String
  postalCode  String
  latitude    Float?
  longitude   Float?
  timezone    String      @default("UTC")
  status      VenueStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business       Business         @relation(fields: [businessId], references: [id])
  cityRel        City?            @relation(fields: [cityId], references: [id])
  facilities     Facility[]
  operatingHours OperatingHours[]
  media          Media[]
  checkIns       CheckIn[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([cityId])
  @@index([city])
  @@index([status])
  @@index([latitude, longitude])
  @@index([status, latitude, longitude])
  @@map("venues")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  facilities Facility[]

  @@map("categories")
}

model Activity {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  slug       String
  icon       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   Category   @relation(fields: [categoryId], references: [id])
  facilities Facility[]

  @@unique([categoryId, slug])
  @@map("activities")
}

model Facility {
  id           String         @id @default(uuid())
  venueId      String
  categoryId   String
  activityId   String?
  name         String
  description  String?
  capacity     Int?
  status       FacilityStatus @default(ACTIVE)
  displayOrder Int            @default(0)

  defaultSlotDuration    Int      @default(60)
  supportedSlotDurations Int[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  venue             Venue               @relation(fields: [venueId], references: [id])
  category          Category            @relation(fields: [categoryId], references: [id])
  activity          Activity?           @relation(fields: [activityId], references: [id])
  availabilityBlocks AvailabilityBlock[]
  pricingRules      PricingRule[]
  bookings          Booking[]
  media             Media[]
  checkIns          CheckIn[]

  @@index([venueId])
  @@index([categoryId])
  @@index([activityId])
  @@index([status])
  @@map("facilities")
}

model Booking {
  id             String        @id @default(uuid())
  organizationId String
  facilityId     String
  userId         String
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(PENDING)
  totalPrice     Decimal?      @db.Decimal(12, 2)
  currency       String?       @default("INR")
  idempotencyKey String?       @unique
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  priceSnapshot  Json?

  organization Organization @relation(fields: [organizationId], references: [id])
  facility     Facility     @relation(fields: [facilityId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  payments     Payment[]
  notifications Notification[]
  checkIn       CheckIn?
  financialTransactions FinancialTransaction[]
  couponRedemptions CouponRedemption[]

  @@index([organizationId])
  @@index([facilityId])
  @@index([userId])
  @@index([startTime, endTime])
  @@index([status])
  @@map("bookings")
}

model OperatingHours {
  id          String    @id @default(uuid())
  venueId     String
  dayOfWeek   DayOfWeek
  openingTime String // HH:mm format
  closingTime String // HH:mm format
  isClosed    Boolean   @default(false)

  venue Venue @relation(fields: [venueId], references: [id])

  @@index([venueId, dayOfWeek])
  @@map("operating_hours")
}

model AvailabilityBlock {
  id         String      @id @default(uuid())
  facilityId String
  startTime  DateTime
  endTime    DateTime
  reason     BlockReason @default(OTHER)
  notes      String?
  createdAt  DateTime    @default(now())

  isRecurring Boolean     @default(false)
  dayOfWeek   DayOfWeek?

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([startTime, endTime])
  @@map("availability_blocks")
}

model PricingRule {
  id            String    @id @default(uuid())
  facilityId    String
  name          String
  basePrice     Decimal   @db.Decimal(12, 2)
  currency      String    @default("INR")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  startTime  String? // HH:mm
  endTime    String? // HH:mm
  daysOfWeek DayOfWeek[]
  priority   Int @default(0)
  isActive   Boolean @default(true)

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@map("pricing_rules")
}

model Payment {
  id                String          @id @default(uuid())
  organizationId    String
  bookingId         String
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR")
  status            PaymentStatus   @default(INITIATED)
  provider          PaymentProvider
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  providerSignature String?
  idempotencyKey    String?         @unique
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  booking      Booking      @relation(fields: [bookingId], references: [id])
  financialTransactions FinancialTransaction[]

  @@index([organizationId])
  @@index([bookingId])
  @@map("payments")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String?
  deviceType String?
  ipAddress  String?
  userAgent  String?
  isActive   Boolean   @default(true)
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  sessionId String
  isUsed    Boolean  @default(false)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@map("refresh_tokens")
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  organizationId String?
  action         String
  resource       String?
  resourceId     String?
  payload        Json?
  ipAddress      String?
  status         String // 'success' or 'failure'
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  bookingId      String?
  type           NotificationType
  title          String
  message        String
  data           Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  booking      Booking?     @relation(fields: [bookingId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Media {
  id              String    @id @default(uuid())
  organizationId  String?
  category        String    @default("VENUE_MEDIA") // VENUE_MEDIA, FACILITY_MEDIA, KYC_DOCUMENT
  entityType      String?   // VENUE, FACILITY, ORGANIZATION, USER
  entityId        String?
  url             String
  storageKey      String
  storageProvider String    @default("s3")
  bucket          String?
  mimeType        String
  fileSize        Int
  type            MediaType @default(IMAGE)
  visibility      String    @default("PUBLIC") // PUBLIC, PRIVATE
  status          String    @default("UPLOAD_PENDING") // UPLOAD_PENDING, UPLOADING, UPLOADED, PROCESSING, READY, FAILED, DELETED
  checksum        String?

  userId          String?
  venueId         String?
  facilityId      String?

  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
  venue           Venue?        @relation(fields: [venueId], references: [id])
  facility        Facility?     @relation(fields: [facilityId], references: [id])

  @@index([organizationId])
  @@index([venueId])
  @@index([facilityId])
  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([entityType, entityId])
  @@map("media")
}

model PaymentWebhookEvent {
  id                  String    @id @default(uuid())
  provider            String
  providerEventId     String
  eventType           String
  signature           String?
  status              String    @default("RECEIVED") // RECEIVED, QUEUED, PROCESSING, PROCESSED, IGNORED, FAILED
  paymentId           String?
  organizationId      String?
  payload             Json?
  receivedAt          DateTime  @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  failedAt            DateTime?
  retryCount          Int       @default(0)
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([provider, providerEventId])
  @@index([provider, providerEventId])
  @@index([status])
  @@index([paymentId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("payment_webhook_events")
}

model CommunicationPreference {
  id        String                @id @default(uuid())
  userId    String
  category  CommunicationCategory
  channel   CommunicationChannel
  isEnabled Boolean               @default(true)
  updatedAt DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category, channel])
  @@map("communication_preferences")
}

model Device {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String? // 'ios', 'android', 'web'
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("devices")
}

model CommunicationLog {
  id             String               @id @default(uuid())
  organizationId String?
  userId         String
  bookingId      String?
  paymentId      String?
  channel        CommunicationChannel
  provider       String
  providerRef    String?
  status         CommunicationStatus
  error          String?
  templateId     String?
  idempotencyKey String?
  metadata       Json?
  sentAt         DateTime?
  createdAt      DateTime             @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, channel, idempotencyKey])
  @@index([userId])
  @@index([organizationId])
  @@index([bookingId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("communication_logs")
}

model CheckIn {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  organizationId String
  venueId        String
  facilityId     String
  userId         String
  checkedInById  String
  timestamp      DateTime @default(now())
  method         String   @default("QR_SCAN")
  status         String   @default("SUCCESS")

  booking      Booking      @relation(fields: [bookingId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  venue        Venue        @relation(fields: [venueId], references: [id])
  facility     Facility     @relation(fields: [facilityId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  checkedInBy  User         @relation("StaffCheckIns", fields: [checkedInById], references: [id])

  @@index([organizationId])
  @@index([venueId])
  @@index([bookingId])
  @@map("check_ins")
}

model FinancialTransaction {
  id             String                   @id @default(uuid())
  organizationId String
  userId         String?
  createdById    String?
  type           FinancialTransactionType
  status         String                   @default("COMPLETED")
  amount         Decimal                  @db.Decimal(12, 2)
  currency       String                   @default("INR")
  description    String?

  referenceType  String? // e.g. 'BOOKING', 'PAYMENT', 'SETTLEMENT', 'REFUND'
  referenceId    String?

  bookingId      String?
  paymentId      String?
  settlementId   String?
  payoutId       String?
  reversalOfId   String?

  idempotencyKey String?                  @unique
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  booking      Booking?              @relation(fields: [bookingId], references: [id])
  payment      Payment?              @relation(fields: [paymentId], references: [id])
  settlement   Settlement?           @relation(fields: [settlementId], references: [id])
  payout       Payout?               @relation(fields: [payoutId], references: [id])
  createdBy    User?                 @relation("CreatedTransactions", fields: [createdById], references: [id])
  reversalOf   FinancialTransaction? @relation("TransactionReversals", fields: [reversalOfId], references: [id])
  reversals    FinancialTransaction[] @relation("TransactionReversals")
  ledgerEntries LedgerEntry[]

  @@index([organizationId])
  @@index([bookingId])
  @@index([paymentId])
  @@index([type])
  @@index([reversalOfId])
  @@map("financial_transactions")
}

model LedgerEntry {
  id                     String   @id @default(uuid())
  financialTransactionId String
  organizationId         String?
  account                String // e.g. 'PARTNER_PAYABLE', 'PLATFORM_REVENUE'
  debit                  Decimal  @default(0) @db.Decimal(12, 2)
  credit                 Decimal  @default(0) @db.Decimal(12, 2)
  currency               String   @default("INR")
  createdAt              DateTime @default(now())

  transaction  FinancialTransaction @relation(fields: [financialTransactionId], references: [id])
  organization Organization?        @relation(fields: [organizationId], references: [id])

  @@index([financialTransactionId])
  @@index([organizationId])
  @@index([account])
  @@map("ledger_entries")
}

model Settlement {
  id             String   @id @default(uuid())
  organizationId String
  status         String   @default("PENDING") // PENDING, FINALIZED, PAID
  startDate      DateTime
  endDate        DateTime
  grossAmount    Decimal  @db.Decimal(12, 2)
  netAmount      Decimal  @db.Decimal(12, 2)
  commission     Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  metadata       Json?
  finalizedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id])
  transactions  FinancialTransaction[]
  payout        Payout?

  @@index([organizationId])
  @@map("settlements")
}

model Payout {
  id                String       @id @default(uuid())
  organizationId    String
  settlementId      String?      @unique
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("INR")
  status            PayoutStatus @default(PENDING)
  provider          String?      @default("MOCK")
  providerReference String?
  failureReason     String?
  metadata          Json?
  initiatedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  settlement   Settlement?  @relation(fields: [settlementId], references: [id])
  transactions FinancialTransaction[]

  @@index([organizationId])
  @@map("payouts")
}

model CommissionConfig {
  id             String    @id @default(uuid())
  organizationId String?   // Null means global default rule
  name           String    @default("Commission Rule")
  percentage     Decimal   @db.Decimal(5, 2) // e.g. 10.00
  fixedFee       Decimal   @default(0) @db.Decimal(12, 2)
  currency       String    @default("INR")
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  priority       Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, isActive])
  @@map("commission_configs")
}

model MembershipPlan {
  id             String   @id @default(uuid())
  organizationId String?  // Null for platform-wide plans
  name           String
  description    String?
  code           String   @unique
  status         String   @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  price          Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  duration       Int      @default(1)
  durationUnit   String   @default("MONTHS") // DAYS, MONTHS, YEARS
  benefits       Json?    // Array of benefit rules
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  customerMemberships CustomerMembership[]

  @@index([organizationId, status])
  @@map("membership_plans")
}

model CustomerMembership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  planId         String
  paymentId      String?
  startDate      DateTime @default(now())
  expiryDate     DateTime
  status         String   @default("ACTIVE") // ACTIVE, EXPIRING, EXPIRED, CANCELLED, SUSPENDED
  amountPaid     Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id])
  organization Organization?   @relation(fields: [organizationId], references: [id])
  plan         MembershipPlan  @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([organizationId])
  @@index([expiryDate])
  @@map("customer_memberships")
}

model Coupon {
  id                     String    @id @default(uuid())
  organizationId         String?   // Null for global coupons
  code                   String    @unique
  description            String?
  discountType           String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue          Decimal   @db.Decimal(12, 2)
  minBookingAmount       Decimal   @default(0) @db.Decimal(12, 2)
  maxDiscountAmount      Decimal?  @db.Decimal(12, 2)
  validFrom              DateTime?
  validTo                DateTime?
  totalRedemptionLimit   Int?
  perUserRedemptionLimit Int       @default(1)
  firstBookingOnly       Boolean   @default(false)
  membershipRequired     Boolean   @default(false)
  venueId                String?
  facilityId             String?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization      Organization?      @relation(fields: [organizationId], references: [id])
  couponRedemptions CouponRedemption[]

  @@index([organizationId, isActive])
  @@index([code])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String
  userId         String
  organizationId String?
  bookingId      String?
  discountAmount Decimal  @db.Decimal(12, 2)
  status         String   @default("CONFIRMED") // RESERVED, CONFIRMED, CANCELLED
  createdAt      DateTime @default(now())

  coupon       Coupon        @relation(fields: [couponId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  booking      Booking?      @relation(fields: [bookingId], references: [id])

  @@index([couponId, userId])
  @@index([userId])
  @@index([bookingId])
  @@map("coupon_redemptions")
}

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([code])
  @@map("referral_codes")
}

model ReferralCampaign {
  id                  String   @id @default(uuid())
  name                String
  isActive            Boolean  @default(true)
  referrerRewardType  String   @default("LOYALTY_POINTS") // LOYALTY_POINTS, FIXED_CREDIT, COUPON
  referrerRewardValue Decimal  @db.Decimal(12, 2)
  refereeRewardType   String   @default("COUPON")
  refereeRewardValue  Decimal  @db.Decimal(12, 2)
  minQualifyingAmount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  referrals Referral[]

  @@map("referral_campaigns")
}

model Referral {
  id                  String   @id @default(uuid())
  campaignId          String?
  referrerId          String
  refereeId          String   @unique
  status              String   @default("PENDING") // PENDING, QUALIFIED, REWARDED, EXPIRED
  qualifyingBookingId String?
  qualifiedAt         DateTime?
  createdAt           DateTime @default(now())

  referrer User              @relation("Referrer", fields: [referrerId], references: [id])
  referee  User              @relation("Referee", fields: [refereeId], references: [id])
  campaign ReferralCampaign? @relation(fields: [campaignId], references: [id])

  @@index([referrerId])
  @@index([refereeId])
  @@index([status])
  @@map("referrals")
}

model LoyaltyAccount {
  id             String   @id @default(uuid())
  userId         String   @unique
  pointsBalance  Int      @default(0)
  lifetimeEarned Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id             String    @id @default(uuid())
  accountId      String
  userId         String
  type           String    // EARN, REDEEM, BONUS, REFERRAL, EXPIRY, REVERSAL, ADMIN_ADJUSTMENT
  points         Int
  balanceAfter   Int
  referenceType  String?   // BOOKING, REFERRAL, ADMIN
  referenceId    String?
  idempotencyKey String?   @unique
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id])
  user    User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@map("loyalty_transactions")
}
