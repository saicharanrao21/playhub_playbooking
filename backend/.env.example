# Database
DATABASE_URL="postgresql://user:password@localhost:5432/playhub?schema=public"

# App
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Security
JWT_ACCESS_SECRET="change-me-at-least-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-at-least-32-chars-long-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:4000"

# Redis
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL=debug

# Payments
RAZORPAY_KEY_ID="rzp_test_change_me"
RAZORPAY_KEY_SECRET="change_me_secret"
RAZORPAY_WEBHOOK_SECRET="change_me_webhook"

STRIPE_SECRET_KEY="sk_test_change_me"
STRIPE_WEBHOOK_SECRET="whsec_change_me"
